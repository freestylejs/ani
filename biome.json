{
    "extends": ["@freestylejs/config/biome"],
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/build",
            "!**/coverage",
            "!**/node_modules",
            "!**/__snapshots__",
            "!**/.*/**",
            "!**/*.d.ts",
            "!**/*.config.*",
            "!bench/layout/results/**"
        ]
    },
    "overrides": [
        {
            "includes": ["bench/layout/**/*.ts"],
            "linter": {
                "rules": {
                    "style": {
                        "noMagicNumbers": "off"
                    }
                }
            }
        }
    ]
}
