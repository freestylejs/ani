{
    "name": "@freestylejs/ani-monorepo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Tiny, but Powerful Declarative Animation Library.",
    "keywords": ["animation", "composition", "declarative", "animation engine"],
    "author": "freestyle",
    "license": "MIT",
    "scripts": {
        "dev": "turbo run build && turbo run dev",
        "build": "pnpm reset:dist && turbo run build --no-cache --force",
        "build:fast": "pnpm reset:dist && turbo run build:fast",
        "start": "turbo run start",
        "test": "vitest run",
        "web": "pnpm run --filter=@freestylejs/ani-web",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest run --coverage",
        "test:browser": "node tests/browser/run.ts",
        "test:bench": "node --test bench/browser/budget.test.ts",
        "test:ci": "pnpm check && pnpm ts:typecheck && pnpm build && pnpm test:coverage",
        "ts:typecheck": "turbo run ts:typecheck",
        "ts:perf": "rimraf ts-perf && tsc --noEmit --generateTrace ts-perf",
        "lint": "biome lint --write",
        "format": "biome format --write",
        "check": "biome check",
        "report": "biome check --reporter=summary",
        "reset:dist": "pnpm -r --parallel exec rimraf dist .turbo .source",
        "reset:modules": "pnpm -r --parallel exec rimraf node_modules && rimraf node_modules .turbo .source",
        "reset": "pnpm reset:dist && pnpm reset:modules",
        "img:compress": "chmod +x ./scripts/img_compress.sh && ./scripts/img_compress.sh",
        "bench:browser": "pnpm --filter @freestylejs/ani-core build && node bench/browser/run.ts",
        "bench:layout": "node bench/layout/run.ts",
        "test:bench-layout": "node --test bench/layout/oracle.test.ts bench/layout/scoring.test.ts",
        "bench:check": "pnpm --filter @freestylejs/ani-core build && node bench/browser/run.ts --check",
        "size": "pnpm --filter @freestylejs/ani-core build && node bench/size/run.ts",
        "soak": "pnpm --filter @freestylejs/ani-core build && node --expose-gc bench/soak/run.ts",
        "pkg:init": "pnpm test:ci && changeset",
        "pkg:version": "changeset version",
        "pkg:publish": "changeset publish",
        "pre-commit": "pnpm check",
        "test:docs-showcase": "node tests/browser/docs_showcase.mjs",
        "test:waapi-trace": "node tests/browser/waapi_trace.ts"
    },
    "packageManager": "pnpm@10.20.0",
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@biomejs/biome": "2.4.9",
        "@changesets/cli": "2.30.0",
        "@freestylejs/config": "1.2.5",
        "@types/babel__core": "7.20.5",
        "@types/istanbul-lib-coverage": "2.0.6",
        "@types/node": "25.5.0",
        "@vitest/coverage-v8": "4.1.2",
        "acorn": "8.15.0",
        "ast-v8-to-istanbul": "1.0.7",
        "babel-plugin-react-compiler": "1.0.0",
        "esbuild": "0.27.0",
        "husky": "9.1.7",
        "istanbul-lib-coverage": "3.2.2",
        "jsdom": "29.0.1",
        "lint-staged": "16.4.0",
        "playwright": "1.55.0",
        "react": "19.2.1",
        "react-18": "npm:react@18.3.1",
        "react-compiler-runtime": "1.0.0",
        "react-dom": "19.2.1",
        "react-dom-18": "npm:react-dom@18.3.1",
        "rimraf": "6.1.3",
        "tsup": "8.5.1",
        "turbo": "2.8.21",
        "typescript": "6.0.2",
        "vite": "8.0.3",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.2"
    }
}
